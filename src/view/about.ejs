<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <script src="https://cdn.socket.io/socket.io-3.0.1.min.js"></script>
        <title>실시간 버튼 누르기</title>
        <link rel="stylesheet" type="text/css" href="../css/index.css" />
        <link rel="stylesheet" type="text/css" href="../css/about.css" />
    </head>
    <ins
    class="kakao_ad_area"
    style="display: none; top: 20%; position: absolute; left: 0%;"
    data-ad-unit="DAN-oQJN02iYektg09FM"
    data-ad-width="160"
    data-ad-height="600"
  ></ins>
    <body>
        <!-- 헤더 -->
        <%- include('share/header') %>
        <div class="inc-dec-wrap">
            <div>
                <h2 id="counter" class="white">0</h2>
            </div>
            <div class="button-wrap">
                <button onclick="increment()" class="goodManners width-100 margin-for-button">▲</button>
                <button onclick="decrement()" class="badManners width-100 margin-for-button">▼</button>
            </div>
        </div>
        <!-- 풋터 -->
        <%- include('share/footer') %>
        <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
        <script type="text/javascript" src="//t1.daumcdn.net/kas/static/ba.min.js" async></script>
        <script>
            const socket = io();

            // 서버로부터 카운터 업데이트 받기
            socket.on('updateCounter', (counter) => {
                $('#counter').text(counter);
            });

            function increment() {
                socket.emit('increment');
            }

            function decrement() {
                socket.emit('decrement');
            }
        </script>
    </body>
    <ins
    class="kakao_ad_area"
    style="display: none; top: 20%; position: absolute; right: 0%;"
    data-ad-unit="DAN-rqjZKqZv2uJWwkY5"
    data-ad-width="160"
    data-ad-height="600"
  ></ins>
</html>
