<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>FCOAlways</title>
        <link
            href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
            rel="stylesheet"
            integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH"
            crossorigin="anonymous"
        />
        <link rel="stylesheet" type="text/css" href="../css/index.css" />
        <link rel="stylesheet" type="text/css" href="../css/simulation.css" />
        <script
            async
            src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-3746750038855279"
            crossorigin="anonymous"
        ></script>
    </head>
    <ins class="kakao_ad_area" style="display: none; top: 20%; position: absolute; left: 0%;"
data-ad-unit = "DAN-2KCdFesbBp9zMxNF"
data-ad-width = "160"
data-ad-height = "600"></ins>
    <body>
        <!-- 헤더 -->
        <%- include('share/header') %>

        <button class="season-show-btn">시즌 보기</button>
        <div class="season-table hide">
            <table>
                <tbody>
                    <tr class="line-1"></tr>
                    <tr class="line-2"></tr>
                    <tr class="line-3"></tr>
                    <tr class="line-4"></tr>
                    <tr class="line-5"></tr>
                    <tr class="line-6"></tr>
                    <tr class="line-7"></tr>
                    <tr class="line-8"></tr>
                    <tr class="line-9"></tr>
                    <tr class="line-10"></tr>
                    <tr class="line-11"></tr>
                </tbody>
            </table>
        </div>
        <div>
          <div class="player-default-div">
            <div style="position: relative;">
              <img src="../img/player_default.webp" alt="" />
              <div class="grade-div">
                <div class="upgrade-simulation-player-basic">1 ▼</div>
                <ul class="player-grade hide">
                    <li class="font-color upgrade-simulation-player-basic">1</li>
                    <li class="font-color upgrade-simulation-player-basic upgrade-simulation-player-bronze">2</li>
                    <li class="font-color upgrade-simulation-player-basic upgrade-simulation-player-bronze">3</li>
                    <li class="font-color upgrade-simulation-player-basic upgrade-simulation-player-bronze">4</li>
                    <li class="font-color upgrade-simulation-player-basic upgrade-simulation-player-silver">5</li>
                    <li class="font-color upgrade-simulation-player-basic upgrade-simulation-player-silver">6</li>
                    <li class="font-color upgrade-simulation-player-basic upgrade-simulation-player-silver">7</li>
                    <li class="font-color upgrade-simulation-player-basic upgrade-simulation-player-gold">8</li>
                    <li class="font-color upgrade-simulation-player-basic upgrade-simulation-player-gold">9</li>
                </ul>
              </div>
            </div>
              
          </div>
        </div>
        <div class="loading hide">
            <img src="../img/loading-7528_256.gif" alt="Loading" />
        </div>

        <%- include('share/footer') %>
        <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
        <script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/2.5.0/Chart.min.js"></script>
        <script type="module" src="../js/header.js"></script>
        <script type="module" src="../js/simulation.js"></script>
        <script type="text/javascript" src="//t1.daumcdn.net/kas/static/ba.min.js" async></script>
        <script
            src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
            integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz"
            crossorigin="anonymous"
        ></script>
    </body>
    <ins class="kakao_ad_area" style="display: none; top: 20%; position: absolute; right: 0%;"
data-ad-unit = "DAN-z5PSCNKfgLt7Wjvq"
