<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>FCOAlways</title>
        <link
            href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
            rel="stylesheet"
            integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH"
            crossorigin="anonymous"
        />
        <link rel="stylesheet" type="text/css" href="../css/index.css" />
    </head>
    <body>
        <!-- 헤더 -->
        <%- include('share/header') %>

        <!-- 검색창 -->
        <div class="input-group mb-3" id="nickName-input">
            <div class="searchinfo">
                <input
                    type="text"
                    class="idinput form-control border-success"
                    placeholder="닉네임"
                    aria-label="Recipient's username"
                    aria-describedby="button-addon2"
                />
                <button class="btn" id="pw">❔</button>
            </div>
        </div>

        <!-- 닉네임을 찾지 못했을 경우 -->
        <div class="notFoundNickName"></div>

        <div class="userInfoPage hide">
            <!-- 검색 클릭시 나타나는 모든 정보 -->
            <div class="allUserInfo">
                <div class="showUserRandomPhoto"></div>
                <div class="checkMannerBtn">
                    <button class="goodManners">GOOD</button>
                    <button class="badManners">BAD</button>
                </div>
                <div class="showUserInfoTable"></div>
            </div>

            <!-- 유저 플레이 정보 -->
            <div>
                <table class="userAllMatchInfo"></table>
            </div>
        </div>
        
        <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
        <script type="module" src="../js/index.js"></script>
        <script
            src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
            integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz"
            crossorigin="anonymous"
        ></script>
    </body>
</html>
