<link rel="stylesheet" type="text/css" href="../css/matchInfoModal.css" />

<div id="matchInfoModal" class="modal slide-modal" tabindex="-1" data-bs-backdrop="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <div class="modal-title detail-click-tab">Match Detail</div>
                <div class="modal-member-tab">Member</div>
                <div class="modal-Squad-tab">Squad</div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close">
                    x
                </button>
            </div>
            <!-- Match Detail -->
            <div class="modal-body">
                <div class="detail-score"></div>
                <div class="chart">
                    <!-- 점유율 -->
                    <canvas id="possesseionRateChart"></canvas>
                    <div class="possesseionPercentage"></div>
                    <!-- 슛 정확도 -->
                    <canvas id="shootRateChart"></canvas>
                    <div class="shootPercentage"></div>
                    <!-- 패스 정확도 -->
                    <canvas id="passRateChart"></canvas>
                    <div class="passPercentage"></div>
                </div>
                <div class="chart-name-div">
                    <p class="chart-p">볼 점유율</p>
                    <p class="chart-p">슛 정확도</p>
                    <p class="chart-p">패스 정확도</p>
                </div>
                <div class="matchDetailInfo" style="color: white"></div>
            </div>

            <!-- 선수들 -->
            <div></div>
            <!-- 스쿼드 -->
            <div class="modal-body squad-section">
                <div class="soccer-field">
                    <div class="player position-GK">GK</div>
                    <div class="player position-SW">SW</div>
                    <div class="player position-RWB">RWB</div>
                    <div class="player position-RB">RB</div>
                    <div class="player position-RCB">RCB</div>
                    <div class="player position-CB">CB</div>
                    <div class="player position-LCB">LCB</div>
                    <div class="player position-LB">LB</div>
                    <div class="player position-LWB">LWB</div>
                    <div class="player position-RDM">RDM</div>
                    <div class="player position-CDM">CDM</div>
                    <div class="player position-LDM">LDM</div>
                    <div class="player position-RM">RM</div>
                    <div class="player position-RCM">RCM</div>
                    <div class="player position-CM">CM</div>
                    <div class="player position-LCM">LCM</div>
                    <div class="player position-LM">LM</div>
                    <div class="player position-RAM">RAM</div>
                    <div class="player position-CAM">CAM</div>
                    <div class="player position-LAM">LAM</div>
                    <div class="player position-RF">RF</div>
                    <div class="player position-CF">CF</div>
                    <div class="player position-LF">LF</div>
                    <div class="player position-RW">RW</div>
                    <div class="player position-RS">RS</div>
                    <div class="player position-ST">ST</div>
                    <div class="player position-LS">LS</div>
                    <div class="player position-LW">LW</div>
                    <!-- 필요한 만큼 선수 추가 -->
                </div>
            </div>
        </div>
    </div>
</div>
